#!/bin/bash
# 宿主只管理 Docker/Git；客户端业务命令在所属容器中执行。
set -euo pipefail
umask 077

usage() {
    cat <<'EOF'
用法：private/workbenches/workbench DIR [COMMAND] [客户端命令参数]

  build            从 main 或 workbench.json.ref 构建/复用镜像
  plan             只读核对服务器，不构建或启动
  open             创建实例并确认入图；已有实例沿用原版本
  status           查询本工作台，省略命令时默认执行
  close            正常关闭并核对所属容器退出
  resources-check  用无头镜像离线检查原版 Data/IMG，不登录
  ai               在所属客户端容器中运行 harness
  notes            读取本工作台 README、PLAN、HANDOFF 和脚本说明
  其他命令         交给所属容器内的 beidou-pilot

  --list           列出本机已有工作台目录
  --help           显示本说明

目录内维护 account.json、可选 workbench.json、计划、脚本与运行数据。
workbench.json 可配置 backend、ref、timeout、bridge_artifact、harness、model_proxy。
默认 headless、main、90秒；harness=true 使用客户端衍生的 Codex 镜像。
常驻服务器由本脚本固定；server 对象仅用于显式开发隔离目标。
资源路径统一读取主检出 private/workbenches/resources.json，不接收命令行配置覆盖。
EOF
}

fail() {
    if [ "${command-}" = build ] && [ -n "${build_stage-}" ]; then
        build_error_code=$1
        build_error_message=$2
    else
        jq -nc --arg code "$1" --arg message "$2" '{ok:false,error:{code:$code,message:$message}}'
    fi
    exit 2
}

begin_preparation_stage() {
    if [ "$command" = build ]; then
        build_stage=$1
        build_stage_started=$EPOCHREALTIME
    fi
}

complete_preparation_stage() {
    if [ "$command" = build ]; then
        preparation=$(jq -nc --argjson completed "$preparation" --arg stage "$build_stage" \
            --arg outcome "$1" --argjson details "$2" --argjson started "$build_stage_started" --argjson ended "$EPOCHREALTIME" \
            '$completed + {($stage):($details + {outcome:$outcome,duration_ms:(($ended-$started)*1000|floor)})}')
    fi
}

if [ "$#" -eq 0 ] || [ "$1" = --help ] || [ "$1" = -h ]; then usage; exit 0; fi
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository=$(git -C "$here" rev-parse --show-toplevel)
main_root=$(git -C "$repository" worktree list --porcelain | sed -n 's/^worktree //p' | head -n1)
if [ "$1" = --list ]; then
    [ "$#" -eq 1 ] || fail usage '--list 不接收其他参数。'
    for directory in "$main_root/private/workbenches"/*; do
        if [ -d "$directory" ] && { [ -f "$directory/account.json" ] || [ -f "$directory/PLAN.md" ]; }; then
            printf '%s\n' "$directory"
        fi
    done
    exit 0
fi
case "$1" in -*) fail usage '先指定工作目录，再指定命令；配置从工作目录读取。' ;; esac
workbench=$1
shift
[ -d "$workbench" ] || fail invalid_workbench '须指定已有工作台目录。'
workbench=$(realpath "$workbench")
command=${1:-status}
if [ "$#" -gt 0 ]; then shift; fi
if [ "$command" = build ]; then
    preparation='{}'
    current_instance=null
    begin_preparation_stage setup
    trap 'build_result=$?; if [ "$build_result" -ne 0 ]; then
        jq -nc --arg code "${build_error_code:-build_command_failed}" \
            --arg message "${build_error_message:-准备命令失败，原始诊断见标准错误。}" \
            --arg stage "$build_stage" --argjson started "$build_stage_started" --argjson ended "$EPOCHREALTIME" \
            --argjson result "$build_result" --argjson preparation "$preparation" --argjson current "$current_instance" \
            "{ok:false,command:\"build\",error:{code:\$code,message:\$message,stage:\$stage,exit_code:\$result,
            duration_ms:((\$ended-\$started)*1000|floor)},data:{preparation:\$preparation,current_instance:\$current}}"
    fi' EXIT
fi
case "$command" in
    --help|-h) usage; exit 0 ;;
    -*) fail usage '配置从 workbench.json 读取，不接收宿主配置参数。' ;;
    build|plan|open|resources-check|close|notes)
        [ "$#" -eq 0 ] || fail usage '宿主命令的配置从工作目录读取，不接收额外参数。' ;;
esac
if [ "$command" = notes ]; then
    printf '工作台：%s\n' "$workbench"
    for document in README.md PLAN.md HANDOFF.md scripts/README.md; do
        if [ -f "$workbench/$document" ]; then
            printf '\n--- %s ---\n' "$document"
            cat -- "$workbench/$document"
        fi
    done
    exit 0
fi
instance=default
workbench_id=$(printf '%s' "$workbench" | sha256sum | cut -c1-10)
timeout=90
name="beidou-pilot-$workbench_id-$instance"
state="$workbench/runtime/$instance"
record="$state/host.json"
id=
inspect=
running=false

locate() {
    running=false
    inspect=
    id=$(docker ps -aq --filter "name=^/$name$") || fail docker_unavailable '无法连接 Docker，未执行客户端操作。'
    [ -n "$id" ] || return 0
    inspect=$(docker inspect "$id" | jq -e --arg wb "$workbench" --arg instance "$instance" '
        .[0] | select(.Config.Labels["beidou.workbench"] == $wb
        and .Config.Labels["beidou.client.instance"] == $instance
        and (.Config.Labels["beidou.task"] == "client-v17-maintained"
             or .Config.Labels["beidou.task"] == "maple-headless-maintained")
        and (.HostConfig.Privileged|not) and .HostConfig.NetworkMode != "host"
        and ((.HostConfig.PortBindings // {})|length) == 0)') ||
        fail container_identity_changed '同名容器的工作台或运行边界不符，保留现场。'
    id=$(jq -r .Id <<<"$inspect")
    running=$(jq -r .State.Running <<<"$inspect")
    if [ -f "$record" ]; then
        [ "$(jq -r .container_id "$record")" = "$id" ] &&
            [ "$(jq -r .image "$record")" = "$(jq -r .Image <<<"$inspect")" ] ||
            fail container_identity_changed '容器与本次运行登记不符，保留现场。'
    fi
}

cleanup_network() {
    local cleanup_record="$record" network server
    if [ -f "$state/pending.json" ]; then cleanup_record="$state/pending.json"; fi
    if [ -f "$cleanup_record" ]; then
        network=$(jq -r '.owned_network // empty' "$cleanup_record")
        server=$(jq -r '.target_container_id // empty' "$cleanup_record")
        if [ -n "$network" ] && docker network inspect "$network" >/dev/null 2>&1; then
            [ "$(docker network inspect "$network" --format '{{index .Labels "beidou.workbench"}}')" = "$workbench" ] ||
                fail network_identity_changed '网络归属变化，未清理。'
            if docker inspect "$server" --format '{{json .NetworkSettings.Networks}}' 2>/dev/null | jq -e --arg n "$network" 'has($n)' >/dev/null; then
                docker network disconnect "$network" "$server"
            fi
            docker network rm "$network" >/dev/null
        fi
    fi
    rm -f "$state/pending.json"
}

archive_exit() {
    local state_json reason
    mkdir -p "$state"
    docker logs "$id" >"$state/container.log" 2>&1
    state_json=$(docker inspect "$id" | jq '.[0].State')
    reason=$(jq -Rr 'fromjson? | select(type=="object") | select(.event=="closed" or .event=="fatal" or .event=="startup_failed") |
        .reason // .code // empty' "$state/container.log" | tail -n1)
    jq -n --argjson state "$state_json" --arg reason "$reason" '
        {exit_code:$state.ExitCode,finished_at:$state.FinishedAt,
        stop_reason:(if $reason!="" then $reason elif $state.ExitCode==0 then "process_exited" else "process_failed" end)}' >"$state/exit.json"
}

exec_program() {
    local token child result=0 interrupted=false cli_user
    token=$(tr -d '-' </proc/sys/kernel/random/uuid)
    cli_user=$(jq -r .Config.User <<<"$inspect")
    if [ "$(jq -r '.Config.Labels["beidou.backend"]' <<<"$inspect")" = beidou ]; then cli_user=1000:1000; fi
    forward_cancel() {
        interrupted=true
        docker exec --user "$cli_user" "$id" beidou-pilot --cancel-exec "$token" >/dev/null ||
            printf '%s\n' '调用中断尚未确认；保留所属实例，原生任务状态请另行查询。' >&2
    }
    trap forward_cancel INT TERM
    setsid docker exec -i --user "$cli_user" --env "BEIDOU_EXEC_TOKEN=$token" --env OPENAI_API_KEY "$id" "$@" <&0 &
    child=$!
    wait "$child" || result=$?
    if "$interrupted"; then
        result=0
        wait "$child" || result=$?
    fi
    trap - INT TERM
    return "$result"
}

exec_cli() {
    exec_program beidou-pilot --json "$@"
}

exec_open() {
    local root
    root=$(jq -r '.Config.Env[] | select(startswith("CLIENT_ROOT=")) | ltrimstr("CLIENT_ROOT=")' <<<"$inspect")
    exec_cli open --account "$root/account.json" --server "$root/server.json" --timeout "$timeout"
}

wait_runtime() {
    local root started seconds
    root=$(jq -r '.Config.Labels["beidou.client.root"]' <<<"$inspect")
    started=$SECONDS
    seconds=$(jq -nr --arg timeout "$timeout" '$timeout | tonumber | ceil')
    until [ -f "$root/state/container.json" ]; do
        if [ "$(docker inspect "$id" --format '{{.State.Running}}')" != true ]; then
            docker logs "$id" >"$root/startup.log" 2>&1
            fail client_start_failed "客户端初始化已退出，日志保存在 $root/startup.log。"
        fi
        [ "$((SECONDS-started))" -lt "$seconds" ] || fail client_start_timeout '客户端尚未发布启动登记，保留现场。'
        sleep 0.05
    done
}

locate
if [ "$command" = build ] && [ -n "$id" ]; then
    current_instance=$(jq -c '{container_id:.Id,image:.Image,running:.State.Running,
        run_id:(.Config.Env | map(select(startswith("RUN_ID=")) | ltrimstr("RUN_ID=")) | first),
        source_revision:.Config.Labels["org.opencontainers.image.revision"],native_inputs_match:null}' <<<"$inspect")
fi
case "$command" in
    close)
        mkdir -p "$state"
        exec 8>"$state/lifecycle.lock"
        flock -n 8 || fail lifecycle_busy '该实例正在启停。'
        locate
        if [ -n "$id" ]; then
            docker stop --time 10 "$id" >/dev/null
            docker inspect "$id" | jq -e '.[0].State | (.Running|not) and .Pid == 0' >/dev/null ||
                fail close_not_confirmed '所属容器尚未确认退出。'
            archive_exit
            docker rm "$id" >/dev/null
        fi
        cleanup_network
        jq -nc --arg instance "$instance" --argjson terminal "$(cat "$state/exit.json" 2>/dev/null || printf '{}')" \
            '{ok:true,command:"close",data:($terminal + {status:"closed",instance:$instance,cleanup_pending:false})}'
        exit 0
        ;;
    status)
        if ! "$running"; then
            if [ -n "$id" ]; then archive_exit; fi
            jq -nc --arg instance "$instance" --argjson old "$(cat "$record" 2>/dev/null || printf '{}')" \
                --argjson terminal "$(cat "$state/exit.json" 2>/dev/null || printf '{}')" '
                {ok:true,command:"status",data:($terminal + {stage:"STOPPED",running:false,instance:$instance,
                image:$old.image,source_revision:$old.source_revision,run_id:$old.run_id})}'
            exit 0
        fi
        exec_cli status "$@"
        exit $?
        ;;
    build|plan|resources-check|open) ;;
    ai)
        "$running" || fail client_not_running '该工作台实例没有运行中的客户端。'
        docker image inspect "$(jq -r .Image <<<"$inspect")" | jq -e '.[0].Config.Labels["beidou.harness"] == "codex"' >/dev/null ||
            fail harness_image_required '新建实例时须在 workbench.json 设置 harness=true。'
        exec_program beidou-game-ai "$@"
        exit $?
        ;;
    *)
        "$running" || fail client_not_running '该工作台实例没有运行中的客户端。'
        exec_cli "$command" "$@"
        exit $?
        ;;
esac

if [ "$command" = open ] && "$running" && [ -f "$record" ]; then
    wait_runtime
    exec_open
    exit $?
fi

if [ -f "$workbench/server.json" ] || [ -f "$workbench/resources.json" ]; then
    fail workbench_migration_required '目录含旧 server.json/resources.json；隔离服务器请配置到 workbench.json.server，资源路径请收拢到公共 resources.json。'
fi
settings='{}'
if [ -f "$workbench/workbench.json" ]; then
    settings=$(jq -e 'select(type == "object") | select(
        ((keys - ["backend", "ref", "timeout", "bridge_artifact", "server", "harness", "model_proxy"]) | length) == 0
        and (if has("backend") then .backend == "headless" or .backend == "beidou" else true end)
        and (if has("ref") then (.ref | type == "string" and length > 0) else true end)
        and (if has("timeout") then (.timeout | type == "number" and . >= 5 and . <= 180) else true end)
        and (if has("bridge_artifact") then (.bridge_artifact | type == "string" and length > 0) else true end)
        and (if has("harness") then (.harness | type == "boolean") else true end)
        and (if has("model_proxy") then (.model_proxy | type == "string"
            and test("^http://([0-9]{1,3}\\.){3}[0-9]{1,3}:[0-9]+$")
            and (ltrimstr("http://") | split(":") | (.[0] | split(".") | all(.[]; tonumber <= 255))
                and (.[1] | tonumber | . >= 1 and . <= 65535))) else true end)
        and (if has("server") then (.server | type == "object"
            and (keys == ["expected_image", "project", "service"] or keys == ["expected_image", "network", "project", "service"])
            and all(.[]; type == "string" and length > 0) and .project != "beidou-ms") else true end)
        )' "$workbench/workbench.json") ||
        fail workbench_config_invalid 'workbench.json 配置无效；server 仅允许显式开发隔离目标。'
fi
backend=$(jq -r '.backend // "headless"' <<<"$settings")
source_ref=$(jq -r '.ref // "main"' <<<"$settings")
timeout=$(jq -r '.timeout // 90' <<<"$settings")
bridge=$(jq -r '.bridge_artifact // empty' <<<"$settings")
harness=$(jq -r '.harness // false' <<<"$settings")
model_proxy=$(jq -r '.model_proxy // empty' <<<"$settings")
model_proxy_ip=
model_proxy_port=
if [ -n "$model_proxy" ]; then
    model_proxy_ip=${model_proxy#http://}
    model_proxy_port=${model_proxy_ip##*:}
    model_proxy_ip=${model_proxy_ip%:*}
fi
if [ -n "$bridge" ]; then
    case "$bridge" in /*) ;; *) bridge="$workbench/$bridge" ;; esac
fi
if [ "$command" = resources-check ]; then backend=headless; harness=false; fi
account="$workbench/account.json"
resources="$main_root/private/workbenches/resources.json"
workspace_server=true

resource_path() {
    local path
    path=$(jq -er --arg field "$1" '.[$field] | select(type == "string" and length > 0)' "$resources")
    case "$path" in /*) ;; *) path="$(dirname "$resources")/$path" ;; esac
    realpath "$path"
}

read_server() {
    if jq -e 'has("server")' <<<"$settings" >/dev/null; then
        workspace_server=false
        server_config=$(jq -c '.server' <<<"$settings")
    else
        workspace_server=true
        local expected_image
        expected_image=$(docker image inspect ghcr.io/beidoums/beidou-server-all:v1.12 --format '{{.Id}}') ||
            fail server_image_unavailable '固定常驻服务器镜像 ghcr.io/beidoums/beidou-server-all:v1.12 不可用。'
        server_config=$(jq -nc --arg image "$expected_image" \
            '{project:"beidou-ms",service:"beidou-server-all",expected_image:$image}')
    fi
}

resolved=
owned_network=
resolve_target() {
    read_server
    project=$(jq -r .project <<<"$server_config")
    service=$(jq -r .service <<<"$server_config")
    servers=$(docker ps -aq --filter "label=com.docker.compose.project=$project" --filter "label=com.docker.compose.service=$service")
    [ "$(wc -w <<<"$servers")" -eq 1 ] || fail target_not_unique '目标必须唯一匹配一个游戏服务容器。'
    server_info=$(docker inspect "$servers" | jq -e '.[0] | select(.State.Running and .HostConfig.NetworkMode != "host")') ||
        fail target_stopped '目标未运行或网络不符合要求。'
    if ! "$workspace_server"; then
        jq -e '((.HostConfig.PortBindings // {})|length) == 0' <<<"$server_info" >/dev/null ||
            fail target_invalid '隔离目标不能发布宿主端口。'
    fi
    server_id=$(jq -r .Id <<<"$server_info")
    server_image=$(jq -r .Image <<<"$server_info")
    [ "$(jq -r .expected_image <<<"$server_config")" = "$server_image" ] || fail server_image_changed '服务器镜像与已确认配置不符。'
    network=$(jq -r '.network // empty' <<<"$server_config")
    if [ -n "$network" ]; then
        docker network inspect "$network" | jq -e --arg project "$project" '.[0] |
            .Internal and .Labels["com.docker.compose.project"] == $project' >/dev/null ||
            fail target_invalid '目标网络必须是同项目的 internal 网络。'
        target_ip=$(jq -er --arg network "$network" '.NetworkSettings.Networks[$network].IPAddress | select(length > 0)' <<<"$server_info") ||
            fail target_invalid '目标尚未加入指定网络。'
    else
        network=
        target_ip=
    fi
    resolved=$(jq -nc --arg project "$project" --arg service "$service" --arg id "$server_id" --arg image "$server_image" \
        --arg network "$network" --arg ip "$target_ip" '{project:$project,service:$service,container_id:$id,image:$image,network:$network,ip:$ip}')
}

if [ "$command" != build ] && [ "$command" != resources-check ]; then
    resolve_target
    if [ "$command" = plan ]; then
        jq -nc --argjson data "$resolved" '{ok:true,command:"plan",data:$data}'
        exit 0
    fi
fi

begin_preparation_stage context
revision=$(git -C "$repository" rev-parse --verify "$source_ref^{commit}")
image_tag="local/beidou-pilot-$backend:$revision"
context="$main_root/tmp/client-images/$revision"
native_paths=(docker/headless/Dockerfile headless/Makefile headless/src shared/lua-runtime
    third_party/maplestory-client third_party/json third_party/lua)
if [ "$backend" = beidou ]; then
    native_paths=(beidou-ijl15/ezorsia beidou-ijl15/ezorsia.sln beidou-ijl15/tools/build-agent-bridge.ps1
        shared/lua-runtime third_party/lua third_party/detours .github/workflows/agent-bridge.yml)
fi
build_image() {
    mkdir -p "$main_root/tmp/client-images"
    exec 9>"$main_root/tmp/client-images/$revision.lock"
    flock 9
    context_outcome=reused
    submodules=$(git -C "$repository" ls-tree -r "$revision" | \
        jq -Rn '[inputs | capture("^160000 commit (?<commit>[0-9a-f]+)\\t(?<path>.*)$")]')
    if [ ! -f "$context/.complete" ]; then
        context_outcome=created
        mkdir -p "$context"
        git -C "$repository" archive "$revision" | tar -x -C "$context"
        while read -r hash path; do
            mkdir -p "$context/$path"
            git -C "$main_root/$path" archive "$hash" | tar -x -C "$context/$path"
        done < <(jq -r '.[] | "\(.commit) \(.path)"' <<<"$submodules")
        touch "$context/.complete"
    fi
    if [ "$command" = build ]; then
        source_tree=$(git -C "$repository" rev-parse "$revision^{tree}")
        if [ -n "$id" ] && [ "$(jq -r '.Config.Labels["beidou.backend"]' <<<"$inspect")" = "$backend" ]; then
            instance_revision=$(jq -r .source_revision <<<"$current_instance")
            if git -C "$repository" cat-file -e "$instance_revision^{commit}" 2>/dev/null; then
                if git -C "$repository" diff --quiet "$instance_revision" "$revision" -- "${native_paths[@]}"; then
                    native_inputs_match=true
                else
                    difference=$?
                    [ "$difference" -eq 1 ] || exit "$difference"
                    native_inputs_match=false
                fi
                current_instance=$(jq -c --argjson matches "$native_inputs_match" '.native_inputs_match=$matches' <<<"$current_instance")
            fi
        fi
        complete_preparation_stage "$context_outcome" "$(jq -nc --arg commit "$revision" --arg tree "$source_tree" \
            --argjson submodules "$submodules" '{source:{commit:$commit,tree:$tree,submodules:$submodules}}')"
    fi
    begin_preparation_stage client_image
    if docker image inspect "$image_tag" >/dev/null 2>&1; then
        docker image inspect "$image_tag" | jq -e --arg rev "$revision" --arg backend "$backend" '
            .[0].Config.Labels | .["org.opencontainers.image.revision"] == $rev and .["beidou.backend"] == $backend' >/dev/null ||
            fail image_identity_changed '版本标签的实际镜像身份不符。'
        image=$(docker image inspect "$image_tag" --format '{{.Id}}')
        complete_preparation_stage reused "$(jq -nc --arg tag "$image_tag" --arg image "$image" '{tag:$tag,image:$image}')"
        if [ "$command" = build ] && [ "$backend" = beidou ]; then
            begin_preparation_stage bridge
            bridge_manifest=$(docker run --rm --network none --read-only --entrypoint cat "$image" /opt/beidou-pilot/native/manifest.json)
            complete_preparation_stage reused "$(jq -nc --argjson manifest "$bridge_manifest" '{source:"image",manifest:$manifest}')"
        fi
        flock -u 9
        return
    fi
    dockerfile=docker/headless/Dockerfile
    if [ "$backend" = beidou ]; then
        begin_preparation_stage bridge
        dockerfile=docker/gui/Dockerfile
        bridge_outcome=reused
        bridge_source=artifact
        bridge_run=null
        if [ -z "$bridge" ]; then
            bridge="$main_root/tmp/client-images/bridges/$revision"
            if [ ! -f "$bridge/manifest.json" ]; then
                run=$(gh run list --repo Diluka/beidou-pilot --workflow agent-bridge.yml --commit "$revision" --status success --limit 1 --json databaseId --jq '.[0].databaseId // empty')
                [ -n "$run" ] || fail bridge_build_required '该提交的 Windows 桥工件尚未就绪；可等待 CI，或在 workbench.json 中指定匹配的 bridge_artifact。'
                mkdir -p "$bridge"
                gh run download "$run" --repo Diluka/beidou-pilot --name maple-agent-bridge-win32 --dir "$bridge" >&2
                bridge_outcome=downloaded
                bridge_source=ci
                bridge_run=$run
            fi
        fi
        bridge=$(realpath "$bridge")
        source_tree=$(jq -er .source.tree_sha "$bridge/manifest.json")
        git -C "$repository" cat-file -e "$source_tree^{tree}" 2>/dev/null ||
            fail bridge_source_unavailable '本地缺少桥工件的来源树，不能确认原生构建输入。'
        git -C "$repository" diff --quiet "$source_tree" "$revision" -- "${native_paths[@]}" ||
            fail bridge_build_required '该提交的 GUI 原生输入已变化，须准备匹配的 Windows 桥工件。'
        mkdir -p "$context/build-input"
        cp "$bridge/ijl15.dll" "$bridge/manifest.json" "$context/build-input/"
        if [ "$command" = build ]; then
            complete_preparation_stage "$bridge_outcome" "$(jq -nc --arg source "$bridge_source" --argjson run "$bridge_run" \
                --slurpfile manifest "$bridge/manifest.json" '{source:$source,manifest:$manifest[0]} +
                (if $run == null then {} else {ci_run_id:$run} end)')"
        fi
    fi
    flock -u 9
    begin_preparation_stage client_image
    docker build --file "$context/$dockerfile" --build-arg "SOURCE_REVISION=$revision" \
        --build-arg HTTP_PROXY --build-arg HTTPS_PROXY --build-arg NO_PROXY --tag "$image_tag" "$context" >&2
    image=$(docker image inspect "$image_tag" --format '{{.Id}}')
    complete_preparation_stage created "$(jq -nc --arg tag "$image_tag" --arg image "$image" '{tag:$tag,image:$image}')"
}
build_image
if "$harness"; then
    begin_preparation_stage harness_image
    client_image=$image_tag
    image_tag="local/beidou-pilot-$backend-ai:$revision"
    harness_outcome=reused
    if docker image inspect "$image_tag" >/dev/null 2>&1; then
        docker image inspect "$image_tag" | jq -e --arg rev "$revision" --arg backend "$backend" '
            .[0].Config.Labels | .["org.opencontainers.image.revision"] == $rev
            and .["beidou.backend"] == $backend and .["beidou.harness"] == "codex"' >/dev/null ||
            fail image_identity_changed 'harness 镜像的版本或后端不符。'
    else
        harness_outcome=created
        client_user=65532:65532
        if [ "$backend" = beidou ]; then client_user=root; fi
        docker build --file "$context/docker/harness/Dockerfile" --build-arg "CLIENT_IMAGE=$client_image" \
            --build-arg "CLIENT_USER=$client_user" --build-arg HTTP_PROXY --build-arg HTTPS_PROXY --build-arg NO_PROXY \
            --tag "$image_tag" "$context" >&2
    fi
    image=$(docker image inspect "$image_tag" --format '{{.Id}}')
    complete_preparation_stage "$harness_outcome" "$(jq -nc --arg tag "$image_tag" --arg image "$image" '{tag:$tag,image:$image}')"
fi
image=$(docker image inspect "$image_tag" --format '{{.Id}}')
if [ "$command" = build ]; then
    if [ -n "$id" ]; then
        current_instance=$(jq -c --arg image "$image" '.matches_prepared_image=(.image==$image)' <<<"$current_instance")
    fi
    jq -nc --arg image "$image" --arg revision "$revision" --arg backend "$backend" \
        --argjson preparation "$preparation" --argjson current "$current_instance" \
        '{ok:true,command:"build",data:{image:$image,source_revision:$revision,backend:$backend,
        preparation:$preparation,current_instance:$current}}'
    exit 0
fi

if [ "$command" = resources-check ]; then
    [ "$backend" = headless ] || fail unsupported_capability 'IMG 离线检查使用 headless 镜像。'
    data=$(resource_path game_data)
    exec docker run --rm --network none --read-only --cpus 2 --memory 1g --pids-limit 128 \
        --cap-drop ALL --security-opt no-new-privileges --user "$(id -u):$(id -g)" \
        --mount "type=bind,src=$data,dst=/data,readonly" --entrypoint /bin/beidou-headless "$image" --check-resources /data
fi

[ -f "$account" ] && [ "$(stat -Lc %a "$account")" = 600 ] || fail private_file_permissions 'account.json 须存在且权限为 0600。'
[ -f "$resources" ] || fail resources_required '须提供共享 private/workbenches/resources.json 资源配置。'
account=$(realpath "$account")
resources=$(realpath "$resources")
data=$(resource_path game_data)
[ -d "$data" ] || fail resources_missing '原版 Data/IMG 资源目录不可用。'
if [ "$backend" = beidou ]; then
    gui=$(resource_path gui_client)
    [ -d "$gui" ] && [ -c /dev/dri/renderD128 ] || fail gui_unavailable '原客户端资源或 GUI 渲染设备不可用。'
fi
mkdir -p "$state"
exec 8>"$state/lifecycle.lock"
flock -n 8 || fail lifecycle_busy '该实例正在启停。'
locate
if "$running"; then
    flock -u 8
    wait_runtime
    exec_open
    exit $?
fi
if [ -n "$id" ]; then
    archive_exit
    docker rm "$id" >/dev/null
fi
cleanup_network
run_id=$(date -u +%Y%m%dT%H%M%S.%NZ)
run_root="$state/$run_id"
container_root="/work/runtime/$instance/$run_id"
mkdir -p "$run_root"
install -m 600 "$account" "$run_root/account.json"
identity=$(docker run --rm --network none --user "$(id -u):$(id -g)" \
    --mount "type=bind,src=$workbench,dst=/work" --entrypoint python3 "$image" \
    -m beidou_pilot.profile "$container_root/account.json")
character_id=$(jq -er .character_id <<<"$identity")
world=$(jq -er .world <<<"$identity")
channel=$(jq -er .channel <<<"$identity")
mkdir -p "$main_root/private/workbenches"
exec 7>"$main_root/private/workbenches/.start.lock"
flock 7
occupied=$(docker ps -q --filter "label=beidou.target.id=$server_id" --filter "label=beidou.character.id=$character_id" --filter "label=beidou.world=$world")
[ -z "$occupied" ] || fail character_already_controlled '该目标的角色已由另一个客户端实例控制。'
if [ -f "$record" ]; then
    previous_root="$state/$(jq -r .run_id "$record")"
    mkdir -p "$previous_root"
    for artifact in host.json exit.json container.log; do
        if [ -f "$state/$artifact" ]; then cp "$state/$artifact" "$previous_root/$artifact"; fi
    done
fi
rm -f "$record" "$state/exit.json"
if [ -z "$network" ]; then
    network="$name-$run_id"
    docker network create --internal --label "com.docker.compose.project=$project" --label "beidou.workbench=$workbench" "$network" >/dev/null
    jq -nc --arg network "$network" --arg server "$server_id" '{owned_network:$network,target_container_id:$server}' >"$state/pending.json"
    docker network connect "$network" "$server_id"
    target_ip=$(docker inspect "$server_id" | jq -er --arg network "$network" '.[0].NetworkSettings.Networks[$network].IPAddress')
    owned_network=$network
fi
target="$run_root/server.json"
jq -nc --arg project "$project" --arg service "$service" --arg network "$network" --arg image "$server_image" \
    '{project:$project,service:$service,network:$network,expected_image:$image}' >"$target"
if [ "$backend" = headless ]; then
    set -- docker run -d --init --name "$name" --network "$network" --read-only --tmpfs /tmp:rw,nosuid,nodev,size=64m \
        --cpus 2 --memory 1g --pids-limit 128 --cap-drop ALL --security-opt no-new-privileges \
        --user "$(id -u):$(id -g)" --label beidou.task=maple-headless-maintained \
        --label "beidou.workbench=$workbench" --label "beidou.client.root=$run_root" --label "beidou.client.instance=$instance" \
        --label "beidou.target.id=$server_id" --label "beidou.character.id=$character_id" --label "beidou.world=$world" \
        --env "CLIENT_IMAGE_ID=$image" --env "RUN_ID=$run_id" --env "MAPLE_INSTANCE=$instance" \
        --env "CLIENT_ROOT=$container_root" --env "MAPLE_RESOURCES_CONFIG=$container_root/config/resources.json" \
        --env "TARGET_IP=$target_ip" --env "TARGET_CONTAINER_ID=$server_id" \
        --env "BEIDOU_WORKBENCH_ID=$workbench_id" \
        --mount "type=bind,src=$workbench,dst=/work" --mount "type=bind,src=$data,dst=/data,readonly"
    if "$harness"; then
        set -- "$@" --env "HTTP_PROXY=$model_proxy" --env "HTTPS_PROXY=$model_proxy" \
            --env "NO_PROXY=localhost,127.0.0.1,$target_ip"
    fi
    "$@" "$image" >/dev/null
else
    export CLIENT_IMAGE="$image" CLIENT_IMAGE_ID="$image" CLIENT_CONTAINER_NAME="$name" WORKBENCH_ROOT="$workbench"
    export CLIENT_ROOT="$run_root" CLIENT_RUNTIME_ROOT="$container_root"
    export BEIDOU_CLIENT_DIR="$gui" GAME_DATA_DIR="$data" TARGET_IP="$target_ip" TARGET_NETWORK="$network"
    export TARGET_CONTAINER_ID="$server_id" RUN_ID="$run_id" MAPLE_INSTANCE="$instance" CHARACTER_ID="$character_id" WORLD_ID="$world"
    export RENDER_GID="$(stat -c %g /dev/dri/renderD128)"
    export BEIDOU_WORKBENCH_ID="$workbench_id"
    export MODEL_PROXY="$model_proxy" MODEL_PROXY_IP="$model_proxy_ip" MODEL_PROXY_PORT="$model_proxy_port"
    set -- docker compose --project-name "$name" -f "$context/docker/compose.yaml"
    "$@" up -d --no-build --pull never client >&2
fi
id=$(docker inspect "$name" --format '{{.Id}}')
if "$harness" && [ -n "$model_proxy" ]; then docker network connect bridge "$id"; fi
jq -nc --arg id "$id" --arg image "$image" --arg revision "$revision" --arg backend "$backend" --arg run "$run_id" \
    --arg network "$owned_network" --arg server "$server_id" --slurpfile target "$target" --argjson identity "$identity" \
    '$identity + {container_id:$id,image:$image,source_revision:$revision,backend:$backend,run_id:$run,
    owned_network:$network,target_container_id:$server,target:$target[0]}' >"$record"
rm -f "$state/pending.json"
flock -u 7
flock -u 8
locate
wait_runtime
exec_open
