# Copy to the private config directory (mode 0600). Generate independent values
# for each secret with `openssl rand -hex 32`; keep them across restarts.
BEIDOU_DEV_DB_ROOT_PASSWORD=
BEIDOU_DEV_DB_PASSWORD=
BEIDOU_DEV_JWT_SECRET=
BEIDOU_DEV_ADMIN_PASSWORD=
# Absolute path to the verified official beidou-cli v1.0.5 JAR (read-only mount).
# Do not point at the old server's CLI wrapper, home, or connection configuration.
BEIDOU_DEV_CLI_JAR=
